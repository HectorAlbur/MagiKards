<?xml version='1.0' encoding='UTF-8'?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="24765" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES">
  <device id="retina6_12" orientation="portrait" appearance="light"/>
  <dependencies>
    <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="24743"/>
    <capability name="Safe area layout guides" minToolsVersion="9.0"/>
    <capability name="Named colors" minToolsVersion="9.0"/>
    <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
  </dependencies>
  <objects>
    <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner" customClass="LoginViewController" customModule="MagiKards" customModuleProvider="target">
      <connections>
        <outlet property="view" destination="root" id="mk-0001"/>
        <outlet property="emailTextField" destination="email" id="mk-0002"/>
        <outlet property="passwordTextField" destination="password" id="mk-0003"/>
        <outlet property="loginButton" destination="login" id="mk-0004"/>
        <outlet property="emailErrorLabel" destination="emailError" id="mk-0005"/>
        <outlet property="passwordErrorLabel" destination="passwordError" id="mk-0006"/>
      </connections>
    </placeholder>
    <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder"/>
    <view id="root" contentMode="scaleToFill">
      <rect key="frame" x="0" y="0" width="393" height="852"/>
      <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
      <subviews>
        <scrollView id="scroll" clipsSubviews="YES" alwaysBounceVertical="YES" keyboardDismissMode="interactive" translatesAutoresizingMaskIntoConstraints="NO">
          <subviews>
            <view id="content" translatesAutoresizingMaskIntoConstraints="NO">
              <subviews>
                <stackView id="stack" axis="vertical" spacing="18" translatesAutoresizingMaskIntoConstraints="NO">
                  <subviews>
                    <imageView id="mk-0007" userLabel="Logo · agregar imagen aquí" contentMode="scaleAspectFit" clipsSubviews="YES" translatesAutoresizingMaskIntoConstraints="NO">
                      <constraints>
                        <constraint id="mk-0008" firstAttribute="height" constant="72"/>
                      </constraints>
                    </imageView>
                    <label id="mk-0009" text="MagiKards" numberOfLines="0" textAlignment="center" translatesAutoresizingMaskIntoConstraints="NO" hidden="NO">
                      <fontDescription key="fontDescription" type="boldSystem" pointSize="38"/>
                      <color key="textColor" name="marketAccent"/>
                    </label>
                    <label id="mk-0010" text="market" numberOfLines="0" textAlignment="center" translatesAutoresizingMaskIntoConstraints="NO" hidden="NO">
                      <fontDescription key="fontDescription" type="system" pointSize="15"/>
                      <color key="textColor" name="marketMuted"/>
                    </label>
                    <stackView id="mk-0011" axis="vertical" spacing="8" translatesAutoresizingMaskIntoConstraints="NO">
                      <subviews>
                        <label id="mk-0012" text="Correo electrónico" numberOfLines="0" textAlignment="left" translatesAutoresizingMaskIntoConstraints="NO" hidden="NO">
                          <fontDescription key="fontDescription" type="boldSystem" pointSize="13"/>
                          <color key="textColor" name="marketText"/>
                        </label>
                        <textField id="email" userLabel="Correo electrónico" placeholder="entrenador@ejemplo.com" borderStyle="roundedRect" contentVerticalAlignment="center" translatesAutoresizingMaskIntoConstraints="NO">
                          <fontDescription key="fontDescription" type="system" pointSize="16"/>
                          <color key="textColor" name="marketText"/>
                          <color key="backgroundColor" name="marketSurface"/>
                          <constraints>
                            <constraint id="mk-0013" firstAttribute="height" constant="54"/>
                          </constraints>
                          <textInputTraits key="textInputTraits" autocorrectionType="no" autocapitalizationType="none" keyboardType="emailAddress" textContentType="emailAddress"/>
                        </textField>
                      </subviews>
                    </stackView>
                    <label id="emailError" text="" numberOfLines="0" textAlignment="left" translatesAutoresizingMaskIntoConstraints="NO" hidden="YES">
                      <fontDescription key="fontDescription" type="system" pointSize="13"/>
                      <color key="textColor" name="marketAccent"/>
                    </label>
                    <stackView id="mk-0014" axis="vertical" spacing="8" translatesAutoresizingMaskIntoConstraints="NO">
                      <subviews>
                        <label id="mk-0015" text="Contraseña" numberOfLines="0" textAlignment="left" translatesAutoresizingMaskIntoConstraints="NO" hidden="NO">
                          <fontDescription key="fontDescription" type="boldSystem" pointSize="13"/>
                          <color key="textColor" name="marketText"/>
                        </label>
                        <textField id="password" userLabel="Contraseña" placeholder="Tu contraseña" borderStyle="roundedRect" contentVerticalAlignment="center" translatesAutoresizingMaskIntoConstraints="NO">
                          <fontDescription key="fontDescription" type="system" pointSize="16"/>
                          <color key="textColor" name="marketText"/>
                          <color key="backgroundColor" name="marketSurface"/>
                          <constraints>
                            <constraint id="mk-0016" firstAttribute="height" constant="54"/>
                          </constraints>
                          <textInputTraits key="textInputTraits" autocorrectionType="no" autocapitalizationType="none" secureTextEntry="YES" textContentType="newPassword"/>
                        </textField>
                      </subviews>
                    </stackView>
                    <label id="passwordError" text="" numberOfLines="0" textAlignment="left" translatesAutoresizingMaskIntoConstraints="NO" hidden="YES">
                      <fontDescription key="fontDescription" type="system" pointSize="13"/>
                      <color key="textColor" name="marketAccent"/>
                    </label>
                    <button id="mk-0017" userLabel="¿Olvidaste tu contraseña?" buttonType="system" translatesAutoresizingMaskIntoConstraints="NO" contentHorizontalAlignment="center" contentVerticalAlignment="center">
                      <constraints>
                        <constraint id="mk-0018" firstAttribute="height" constant="54"/>
                      </constraints>
                      <userDefinedRuntimeAttributes>
                        <userDefinedRuntimeAttribute type="number" keyPath="layer.cornerRadius">
                          <real key="value" value="16"/>
                        </userDefinedRuntimeAttribute>
                      </userDefinedRuntimeAttributes>
                      <color key="backgroundColor" name="marketSoft"/>
                      <fontDescription key="fontDescription" type="boldSystem" pointSize="15"/>
                      <state key="normal" title="¿Olvidaste tu contraseña?">
                        <color key="titleColor" name="marketAccent"/>
                      </state>
                    </button>
                    <button id="login" userLabel="INICIAR SESIÓN" buttonType="system" translatesAutoresizingMaskIntoConstraints="NO" contentHorizontalAlignment="center" contentVerticalAlignment="center">
                      <constraints>
                        <constraint id="mk-0019" firstAttribute="height" constant="54"/>
                      </constraints>
                      <userDefinedRuntimeAttributes>
                        <userDefinedRuntimeAttribute type="number" keyPath="layer.cornerRadius">
                          <real key="value" value="16"/>
                        </userDefinedRuntimeAttribute>
                      </userDefinedRuntimeAttributes>
                      <color key="backgroundColor" name="marketAccent"/>
                      <fontDescription key="fontDescription" type="boldSystem" pointSize="15"/>
                      <state key="normal" title="INICIAR SESIÓN">
                        <color key="titleColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                      </state>
                      <connections>
                        <action selector="requestLogin:" destination="-1" eventType="touchUpInside" id="mk-0020"/>
                      </connections>
                    </button>
                    <button id="mk-0021" userLabel="REGISTRAR NUEVO USUARIO" buttonType="system" translatesAutoresizingMaskIntoConstraints="NO" contentHorizontalAlignment="center" contentVerticalAlignment="center">
                      <constraints>
                        <constraint id="mk-0022" firstAttribute="height" constant="54"/>
                      </constraints>
                      <userDefinedRuntimeAttributes>
                        <userDefinedRuntimeAttribute type="number" keyPath="layer.cornerRadius">
                          <real key="value" value="16"/>
                        </userDefinedRuntimeAttribute>
                      </userDefinedRuntimeAttributes>
                      <color key="backgroundColor" name="marketSoft"/>
                      <fontDescription key="fontDescription" type="boldSystem" pointSize="15"/>
                      <state key="normal" title="REGISTRAR NUEVO USUARIO">
                        <color key="titleColor" name="marketAccent"/>
                      </state>
                    </button>
                    <imageView id="mk-0023" userLabel="Ilustración de entrenadores · agregar imagen aquí" contentMode="scaleAspectFit" clipsSubviews="YES" translatesAutoresizingMaskIntoConstraints="NO">
                      <constraints>
                        <constraint id="mk-0024" firstAttribute="height" constant="120"/>
                      </constraints>
                    </imageView>
                    <label id="mk-0025" text="Tu próxima carta favorita te espera." numberOfLines="0" textAlignment="center" translatesAutoresizingMaskIntoConstraints="NO" hidden="NO">
                      <fontDescription key="fontDescription" type="system" pointSize="12"/>
                      <color key="textColor" name="marketMuted"/>
                    </label>
                  </subviews>
                </stackView>
              </subviews>
              <constraints>
                <constraint id="mk-0026" firstItem="stack" firstAttribute="top" secondItem="content" secondAttribute="top" constant="28"/>
                <constraint id="mk-0027" firstItem="content" firstAttribute="bottom" secondItem="stack" secondAttribute="bottom" constant="28"/>
                <constraint id="mk-0028" firstItem="stack" firstAttribute="centerX" secondItem="content" secondAttribute="centerX"/>
                <constraint id="mk-0029" firstItem="stack" firstAttribute="width" secondItem="content" secondAttribute="width" constant="-48" priority="750"/>
                <constraint id="mk-0030" firstItem="stack" firstAttribute="width" relation="lessThanOrEqual" constant="480"/>
                <constraint id="mk-0031" firstItem="stack" firstAttribute="width" relation="lessThanOrEqual" secondItem="content" secondAttribute="width" constant="-48"/>
              </constraints>
            </view>
          </subviews>
          <constraints>
            <constraint id="mk-0032" firstItem="content" firstAttribute="top" secondItem="scrollContent" secondAttribute="top"/>
            <constraint id="mk-0033" firstItem="content" firstAttribute="bottom" secondItem="scrollContent" secondAttribute="bottom"/>
            <constraint id="mk-0034" firstItem="content" firstAttribute="leading" secondItem="scrollContent" secondAttribute="leading"/>
            <constraint id="mk-0035" firstItem="content" firstAttribute="trailing" secondItem="scrollContent" secondAttribute="trailing"/>
            <constraint id="mk-0036" firstItem="content" firstAttribute="width" secondItem="scrollFrame" secondAttribute="width"/>
          </constraints>
          <viewLayoutGuide key="contentLayoutGuide" id="scrollContent"/>
          <viewLayoutGuide key="frameLayoutGuide" id="scrollFrame"/>
        </scrollView>
      </subviews>
      <viewLayoutGuide key="safeArea" id="safe"/>
      <color key="backgroundColor" name="marketCanvas"/>
      <constraints>
        <constraint id="mk-0037" firstItem="scroll" firstAttribute="top" secondItem="safe" secondAttribute="top"/>
        <constraint id="mk-0038" firstItem="scroll" firstAttribute="bottom" secondItem="safe" secondAttribute="bottom"/>
        <constraint id="mk-0039" firstItem="scroll" firstAttribute="leading" secondItem="safe" secondAttribute="leading"/>
        <constraint id="mk-0040" firstItem="scroll" firstAttribute="trailing" secondItem="safe" secondAttribute="trailing"/>
      </constraints>
    </view>
  </objects>
  <resources>
    <namedColor name="marketAccent">
      <color red="1.000000" green="0.000000" blue="0.329412" alpha="1.000" colorSpace="custom" customColorSpace="sRGB"/>
    </namedColor>
    <namedColor name="marketText">
      <color red="0.145098" green="0.160784" blue="0.211765" alpha="1.000" colorSpace="custom" customColorSpace="sRGB"/>
    </namedColor>
    <namedColor name="marketMuted">
      <color red="0.419608" green="0.447059" blue="0.501961" alpha="1.000" colorSpace="custom" customColorSpace="sRGB"/>
    </namedColor>
    <namedColor name="marketSurface">
      <color red="1.000000" green="1.000000" blue="1.000000" alpha="1.000" colorSpace="custom" customColorSpace="sRGB"/>
    </namedColor>
    <namedColor name="marketCanvas">
      <color red="1.000000" green="1.000000" blue="1.000000" alpha="1.000" colorSpace="custom" customColorSpace="sRGB"/>
    </namedColor>
    <namedColor name="marketBorder">
      <color red="0.898039" green="0.905882" blue="0.921569" alpha="1.000" colorSpace="custom" customColorSpace="sRGB"/>
    </namedColor>
    <namedColor name="marketSoft">
      <color red="1.000000" green="0.945098" blue="0.960784" alpha="1.000" colorSpace="custom" customColorSpace="sRGB"/>
    </namedColor>
    <namedColor name="marketGold">
      <color red="0.717647" green="0.474510" blue="0.000000" alpha="1.000" colorSpace="custom" customColorSpace="sRGB"/>
    </namedColor>
  </resources>
</document>
