                <constraint id="mk-0170" firstItem="content" firstAttribute="bottom" secondItem="stack" secondAttribute="bottom" constant="28"/>
                <constraint id="mk-0171" firstItem="stack" firstAttribute="centerX" secondItem="content" secondAttribute="centerX"/>
                <constraint id="mk-0172" firstItem="stack" firstAttribute="width" secondItem="content" secondAttribute="width" constant="-48" priority="750"/>
                <constraint id="mk-0173" firstItem="stack" firstAttribute="width" relation="lessThanOrEqual" constant="480"/>
                <constraint id="mk-0174" firstItem="stack" firstAttribute="width" relation="lessThanOrEqual" secondItem="content" secondAttribute="width" constant="-48"/>
