                      <constraints>
                        <constraint id="mk-0161" firstAttribute="height" constant="230"/>
                      </constraints>
                    </imageView>
                    <label id="mk-0162" text="Cada carta tiene&#10;una nueva historia." numberOfLines="0" textAlignment="center" translatesAutoresizingMaskIntoConstraints="NO" hidden="NO">
