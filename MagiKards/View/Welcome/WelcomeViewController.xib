                      </constraints>
                    </imageView>
                    <label id="mk-0158" text="MagiKards" numberOfLines="0" textAlignment="center" translatesAutoresizingMaskIntoConstraints="NO" hidden="NO">
                      <fontDescription key="fontDescription" type="boldSystem" pointSize="38"/>
                      <color key="textColor" name="marketAccent"/>
                    </label>
