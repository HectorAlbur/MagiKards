                      </constraints>
                      <userDefinedRuntimeAttributes>
                        <userDefinedRuntimeAttribute type="number" keyPath="layer.cornerRadius">
                          <real key="value" value="16"/>
                        </userDefinedRuntimeAttribute>
                      </userDefinedRuntimeAttributes>
                      <color key="backgroundColor" name="marketAccent"/>
                      <fontDescription key="fontDescription" type="boldSystem" pointSize="15"/>
                      <state key="normal" title="ENVIAR ENLACE">
                        <color key="titleColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                      </state>
                    </button>
                    <label id="mk-0095" text="Revisa también tu carpeta de correo no deseado." numberOfLines="0" textAlignment="left" translatesAutoresizingMaskIntoConstraints="NO" hidden="NO">
