                      <color key="textColor" name="marketMuted"/>
                    </label>
                    <button id="mk-0096" userLabel="Volver a iniciar sesión" buttonType="system" translatesAutoresizingMaskIntoConstraints="NO" contentHorizontalAlignment="center" contentVerticalAlignment="center">
