                    <label id="mk-0087" text="Recupera tu acceso" numberOfLines="0" textAlignment="left" translatesAutoresizingMaskIntoConstraints="NO" hidden="NO">
                      <fontDescription key="fontDescription" type="boldSystem" pointSize="32"/>
                      <color key="textColor" name="marketText"/>
                    </label>
                    <label id="mk-0088" text="Escribe el correo de tu cuenta para solicitar un enlace de recuperación." numberOfLines="0" textAlignment="left" translatesAutoresizingMaskIntoConstraints="NO" hidden="NO">
                      <fontDescription key="fontDescription" type="system" pointSize="16"/>
                      <color key="textColor" name="marketMuted"/>
                    </label>
                    <stackView id="mk-0089" axis="vertical" spacing="8" translatesAutoresizingMaskIntoConstraints="NO">
                      <subviews>
                        <label id="mk-0090" text="Correo electrónico" numberOfLines="0" textAlignment="left" translatesAutoresizingMaskIntoConstraints="NO" hidden="NO">
                          <fontDescription key="fontDescription" type="boldSystem" pointSize="13"/>
                          <color key="textColor" name="marketText"/>
                        </label>
                        <textField id="mk-0091" userLabel="Correo electrónico" placeholder="entrenador@ejemplo.com" borderStyle="roundedRect" contentVerticalAlignment="center" translatesAutoresizingMaskIntoConstraints="NO">
                          <fontDescription key="fontDescription" type="system" pointSize="16"/>
                          <color key="textColor" name="marketText"/>
                          <color key="backgroundColor" name="marketSurface"/>
                          <constraints>
                            <constraint id="mk-0092" firstAttribute="height" constant="54"/>
                          </constraints>
                          <textInputTraits key="textInputTraits" autocorrectionType="no" autocapitalizationType="none" keyboardType="emailAddress" textContentType="emailAddress"/>
                        </textField>
                      </subviews>
                    </stackView>
                    <button id="mk-0093" userLabel="ENVIAR ENLACE" buttonType="system" translatesAutoresizingMaskIntoConstraints="NO" contentHorizontalAlignment="center" contentVerticalAlignment="center">
                      <constraints>
