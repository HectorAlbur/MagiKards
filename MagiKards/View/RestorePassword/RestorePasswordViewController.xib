                          <real key="value" value="16"/>
                        </userDefinedRuntimeAttribute>
                      </userDefinedRuntimeAttributes>
                      <color key="backgroundColor" name="marketSoft"/>
                      <fontDescription key="fontDescription" type="boldSystem" pointSize="15"/>
                      <state key="normal" title="Volver a iniciar sesión">
                        <color key="titleColor" name="marketAccent"/>
                      </state>
                    </button>
                  </subviews>
                </stackView>
              </subviews>
              <constraints>
                <constraint id="mk-0098" firstItem="stack" firstAttribute="top" secondItem="content" secondAttribute="top" constant="28"/>
                <constraint id="mk-0099" firstItem="content" firstAttribute="bottom" secondItem="stack" secondAttribute="bottom" constant="28"/>
                <constraint id="mk-0100" firstItem="stack" firstAttribute="centerX" secondItem="content" secondAttribute="centerX"/>
                <constraint id="mk-0101" firstItem="stack" firstAttribute="width" secondItem="content" secondAttribute="width" constant="-48" priority="750"/>
                <constraint id="mk-0102" firstItem="stack" firstAttribute="width" relation="lessThanOrEqual" constant="480"/>
                <constraint id="mk-0103" firstItem="stack" firstAttribute="width" relation="lessThanOrEqual" secondItem="content" secondAttribute="width" constant="-48"/>
