                      <constraints>
                        <constraint id="mk-0085" firstAttribute="height" constant="112"/>
                      </constraints>
                    </imageView>
                    <label id="mk-0086" text="NO PIERDAS TU COLECCIÓN" numberOfLines="0" textAlignment="left" translatesAutoresizingMaskIntoConstraints="NO" hidden="NO">
